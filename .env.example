# flomo 直接 Token（可选，设置后跳过 OAuth 授权流程）
# 可从 flomo MCP 配置中获取
FLOMO_TOKEN=

# flomo MCP 服务地址（默认即可）
FLOMO_MCP_URL=https://flomoapp.com/mcp

# LLM API（AI 加工）
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_MODEL=
# 输出上限包含推理消耗；默认 16384，按服务支持范围调整
LLM_MAX_OUTPUT_TOKENS=16384

# 本地数据库路径（可选，默认 ./data/cache.db）
DB_PATH=

# 工作台服务（Web、CLI、MCP 共用）
PORT=3000
# 默认沿用 DB_PATH；原有缓存表不会删除
WORKBENCH_DB_PATH=
FLOMO_WORKBENCH_URL=http://127.0.0.1:3000
# 工作台已部署在另一台设备时，可让本地网页、CLI、MCP 共用远端服务
# 启用后，本地只转发页面/API/实时事件，不打开本地数据库
# WORKBENCH_REMOTE_URL=http://10.8.0.5:8888/flomo
# 与收藏库使用同一个代理时，在这里填相同地址（不会自动继承）
# WORKBENCH_REMOTE_PROXY=socks5://127.0.0.1:1080
# 网关 HTTP 端口；启用后自动识别当前本机 IPv4 地址，局域网换址无需改配置或重启
# WORKBENCH_GATEWAY_PORTS=8888
# 额外允许的网关 IPv4 来源网段；逗号分隔，沿用上面的端口
# WORKBENCH_GATEWAY_SUBNETS=10.8.0.0/24
# 可选：固定域名或 HTTPS 来源，精确匹配协议、地址和端口；不含路径或末尾斜杠
# WORKBENCH_ALLOWED_ORIGINS=https://flomo.example.com

# 收藏库（可选）：现有 js-knowledge-collector 服务地址
# 本机运行时请使用不同端口，例如 collector 3001、工作台 3000
COLLECTOR_BASE_URL=
COLLECTOR_API_PREFIX=/api/v1
COLLECTOR_TOKEN=
# 收藏库需要代理时设置，例如 socks5://127.0.0.1:1080
COLLECTOR_HTTP_PROXY=
