# flomo 直接 Token（可选，设置后跳过 OAuth 授权流程）
# 可从 flomo MCP 配置中获取
FLOMO_TOKEN=

# flomo MCP 服务地址（默认即可）
FLOMO_MCP_URL=https://flomoapp.com/mcp

# LLM API（AI 加工）
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_MODEL=

# 本地数据库路径（可选，默认 ./data/cache.db）
DB_PATH=

# 工作台服务（Web、CLI、MCP 共用）
PORT=3000
# 默认沿用 DB_PATH；原有缓存表不会删除
WORKBENCH_DB_PATH=
FLOMO_WORKBENCH_URL=http://127.0.0.1:3000
